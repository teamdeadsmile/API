# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Local example:
#   postgresql://postgres:password@localhost:5432/deadsmile
# Managed (Neon/Render/Supabase/RDS) — SSL is auto-detected from the host.
DATABASE_URL=postgresql://user:password@localhost:5432/deadsmile

# ─── Session ──────────────────────────────────────────────────────────────────
# REQUIRED — at least 64 random characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=CHANGE_ME_64_RANDOM_HEX_CHARS

# ─── CORS / Cookies ───────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# lax (same-site dev) | none (cross-site + HTTPS prod) | strict
COOKIE_SAMESITE=lax

# ─── Admin seed (only used by `npm run seed:admin`, never read by the API) ───
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=admin
